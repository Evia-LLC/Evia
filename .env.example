# Elohim environment. Copy to .env and fill in. Nothing here is required to run
# the app on a laptop - without a key she runs the labelled local engine, and
# without a blob key she keeps numbers but not photos.

# --- AI ---
# Without this, the conversation engine runs the clearly-labelled local
# fallback ("Demo Elohim"). Set it and Claude takes over.
ANTHROPIC_API_KEY=

# Model overrides (defaults shown). Sonnet is the default on purpose: it writes
# her paragraph in her voice for a fraction of Opus's price and latency.
ELOHIM_MODEL=claude-sonnet-5
ELOHIM_CLASSIFIER_MODEL=claude-haiku-4-5
# Set to 1 to classify intent with the small model instead of the local rules.
# Still behind the user's cloud-reasoning consent.
ELOHIM_MODEL_CLASSIFIER=0

# Spend caps, per day. Over the cap she keeps talking, from the local engine.
ELOHIM_USER_DAILY_TURNS=80
ELOHIM_DAILY_TURNS=2000
ELOHIM_DAILY_TOKENS=4000000

# --- Voice ---
# Her licensed voice, cloned. Both are needed; without them she speaks with
# the browser's own synthesiser and the interface says so.
ELOHIM_VOICE_API_KEY=
ELOHIM_VOICE_ID=
# ELOHIM_VOICE_MODEL=eleven_multilingual_v2
# ELOHIM_VOICE_ENDPOINT=https://api.elevenlabs.io/v1/text-to-speech
# Whether guests (no account) may hear the cloned voice. Their replies still
# contain their readings, so this is a choice about a third party, not a
# convenience toggle.
ELOHIM_GUEST_VOICE=1

# --- Server ---
ELOHIM_PORT=5196
ELOHIM_WEB_PORT=5195

# --- Storage ---
# Postgres. Locally, leave unset and `node scripts/dev.mjs` starts PGlite.
# On Netlify set NETLIFY_DATABASE_URL or DATABASE_URL to any hosted Postgres.
DATABASE_URL=

# 32-byte hex key for AES-256-GCM encryption of stored face images.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, image storage is refused rather than written in the clear.
ELOHIM_BLOB_KEY=

# --- Shop ---
# Your own catalogue. A Shopify or WooCommerce storefront URL is read
# directly; anything else can be imported as JSON through the admin route
# (each imported product may say who sells it: "retailer": "Sephora").
ELOHIM_STORE_URL=
# The name on "Shop at ..." for products synced from ELOHIM_STORE_URL, e.g.
# "Northside Apothecary". There is no default: leave it empty and every
# product is named by its own retailer, worked out from its link (Amazon,
# Sephora, the brand's own site, or the site's address).
ELOHIM_STORE_NAME=
# Protects the catalogue sync and import routes.
ELOHIM_ADMIN_TOKEN=
# Optional price comparison beyond your shop. Without keys she links to a
# search rather than claiming to have compared.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
ELOHIM_AMAZON_DOMAIN=www.amazon.com
# Affiliate links. The Products page sends people to the retailer ("Shop at
# ... ↗"); each retailer's programme is set on its own and its parameters are
# added only to that retailer's links. Only these static strings are ever
# added: nothing from a scan, a profile or a recommendation goes into a URL
# (SRS ADS-01), and a parameter whose name looks meant for such data is
# refused. Leave any of them empty to send plain links to that retailer.
#   Amazon Associates tracking id, sent as tag= (ELOHIM_AMAZON_TAG, the older
#   name for this, is still read).
ELOHIM_AFFILIATE_AMAZON_TAG=
#   eBay Partner Network query as issued, e.g.
#   mkevt=1&mkcid=1&mkrid=711-53200-19255-0&campid=<your id>&toolid=10001
ELOHIM_AFFILIATE_EBAY_PARAMS=
#   A query for your own shop's links (ELOHIM_STORE_URL), e.g. ref=evia
ELOHIM_AFFILIATE_STORE_PARAMS=
#   Any other retailer an imported catalogue links to: space-separated
#   host:query pairs, e.g. sephora.com:om_mmc=aff-evia boots.com:aff=evia
ELOHIM_AFFILIATE_LINKS=

# --- Development ---
# Seeds a demo user (demo@elohim.local / demo1234) with real scan history.
DEMO_MODE=1
ELOHIM_LOG_LEVEL=debug
