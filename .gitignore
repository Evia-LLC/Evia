node_modules/
dist/
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal
data/blobs/
.env
.env.local
.env.*
!.env.example
*.log
shots/

# Holds the Meshy API key in plain text. Local machine config, never committed.
.mcp.json

# SpriteCook request payloads (base64 image bodies, too big for argv)
.sc/

# MediaPipe wasm runtime (~33MB) — regenerated by scripts/sync-mediapipe.mjs
public/mediapipe/
public/models/*.task

# Netlify link + local build state
.netlify

# Local in-process Postgres (PGlite) used by scripts/dev.mjs when no DATABASE_URL is set
data/pglite/

# Production key backups, never to be committed
.secrets/

.vercel

# Manager-provided legal docs — confidential, never committed
Manager/


# The retired 3D-model era (Meshy GLBs and bakes, ~95MB): the painted sprite
# replaced the rigged model, nothing imports these, and GitHub is not the
# archive for them. They stay on this machine.
art/
