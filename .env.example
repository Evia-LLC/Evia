# Elohim environment. Copy to .env and fill in. Nothing here is required to run
# the app on a laptop - without a key she runs the labelled local engine, and
# without a blob key she keeps numbers but not photos.

# --- AI ---
# Server-only. OpenAI handles conversation, consented image/label reading,
# and the fixed AI-generated voice. Never prefix this key with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-2025-04-14
OPENAI_CLASSIFIER_MODEL=gpt-4.1-mini-2025-04-14
# Optional legacy provider, used only when OPENAI_API_KEY is absent.
# OpenAI failures do not silently send the same data to another provider.
ANTHROPIC_API_KEY=

# Legacy Anthropic model overrides (defaults shown).
ELOHIM_MODEL=claude-sonnet-5
ELOHIM_CLASSIFIER_MODEL=claude-haiku-4-5
# Set to 1 to classify intent with the small model instead of the local rules.
# Still behind the user's cloud-reasoning consent.
ELOHIM_MODEL_CLASSIFIER=0

# Spend caps, per day. Over the cap she keeps talking, from the local engine.
ELOHIM_USER_DAILY_TURNS=80
ELOHIM_DAILY_TURNS=2000
ELOHIM_DAILY_TOKENS=4000000

# --- Voice ---
# OPENAI_API_KEY is shared with the AI configuration above, server-side only.
# Every line uses this one AI-generated voice, including fixed greetings.
# Missing configuration or provider failure leaves the reply as text.
OPENAI_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
OPENAI_TTS_VOICE=marin
OPENAI_TTS_SPEED=1
# Optional delivery guidance (maximum 4096 characters).
# OPENAI_TTS_INSTRUCTIONS=Speak as a warm, reassuring beauty consultant.
# Whether guests may send reply text to OpenAI for speech generation.
ELOHIM_GUEST_VOICE=1

# --- Server ---
ELOHIM_PORT=5196
ELOHIM_WEB_PORT=5195

# --- Storage ---
# Postgres. Locally, leave unset and `node scripts/dev.mjs` starts PGlite.
# On Netlify set NETLIFY_DATABASE_URL or DATABASE_URL to any hosted Postgres.
DATABASE_URL=

# 32-byte hex key for AES-256-GCM encryption of stored face images.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, image storage is refused rather than written in the clear.
ELOHIM_BLOB_KEY=

# --- Shop ---
# Your own catalogue. A Shopify or WooCommerce storefront URL is read
# directly; anything else can be imported as JSON through the admin route.
ELOHIM_STORE_URL=
ELOHIM_STORE_NAME=Ese
# Protects the catalogue sync and import routes.
ELOHIM_ADMIN_TOKEN=
# Optional price comparison beyond your shop. Without keys she links to a
# search rather than claiming to have compared.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
ELOHIM_AMAZON_TAG=
ELOHIM_AMAZON_DOMAIN=www.amazon.com

# --- Development ---
# Local development automatically seeds a demo user with synthetic scan history.
# Always set DEMO_MODE=0 in deployed environments; never publish demo credentials.
# DEMO_MODE=0
ELOHIM_LOG_LEVEL=debug
